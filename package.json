{
  "name": "codeharbor",
  "version": "0.1.0",
  "private": true,
  "description": "A local Docker-based development environment manager for creating and running isolated development workspaces.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:clean": "node scripts/clean-dev.mjs",
    "tauri:dev": "npm run dev:clean && tauri dev",
    "tauri:build": "tauri build",
    "mac:install": "node scripts/install-mac-app.mjs",
    "mac:uninstall": "node scripts/uninstall-mac-app.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:all": "node scripts/test-all.mjs",
    "prototype:config": "docker compose -f prototype/docker-workspace/compose.yaml config",
    "prototype:up": "docker compose -f prototype/docker-workspace/compose.yaml up --build -d",
    "prototype:down": "docker compose -f prototype/docker-workspace/compose.yaml down"
  },
  "keywords": [
    "docker",
    "development-environment",
    "devcontainer",
    "workspace",
    "docker-compose",
    "tauri",
    "react",
    "typescript",
    "rust",
    "macos",
    "developer-tools",
    "amd64",
    "arm64"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0"
  }
}
