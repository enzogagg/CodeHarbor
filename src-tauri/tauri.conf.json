{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CodeHarbor",
  "version": "0.1.0",
  "identifier": "com.codeharbor.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CodeHarbor",
        "width": 1080,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
